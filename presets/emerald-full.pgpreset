{
  "presetVersion": 1,
  "type": "full",
  "name": "Pokemon Emerald",
  "game": {
    "color": "#2ecc71",
    "steps": [
      "Walk out of the truck",
      "Change clock's hour in your bedroom",
      "Go to rival's house, go up the stairs, talk to the rival in their room",
      "Leave Littleroot Town and head north",
      "Help Professor Birch by choosing a starter Pokémon from his bag",
      "Heal your Pokemon in Oldale Town's Poke-ceneter",
      "Locate May/Brendan on Route 103",
      "Return to Professor Birch's Lab",
      "Talk to your mom to obtain \"Running Shoes\"",
      "Head towards Petalburg Town",
      "Meet your father, Norman inside the Gym",
      "Reach Rustboro City",
      "Defeat Rock Gym",
      "Recover Devon Goods and save Peeko located inside Rusturf Tunnel",
      "Go to Devon Corportaion and meet Mr. Stone.",
      "Talk to Mr. Briney at his cottage to sail to Dewford Town",
      "Find Steven inside Granite Cave",
      "Defeat Fighting Gym",
      "Sail to Slateport City",
      "Talk to Captain Stern in Oceanic Museum",
      "Travel north towards Mauville City",
      "Obtain Bike from Rydel's Cycles (You can switch later on, do not stress on which bike to take)",
      "Defeat Electric Gym",
      "Head to Verdanturf Town",
      "Return to Mauville and speak to Wattson(Gym Leader) after defeating him.",
      "Reach Fallarbor Town",
      "Enter Meteor Falls and watch 'cutscene'",
      "Talk to Mt. Chimney",
      "Take the cable car up the mountain",
      "Defeat Maxie during the mountain confrontation",
      "Reach Lavaridge Town",
      "Defeat Fire Gym",
      "Talk to your rival outside of the Fire Gym",
      "Return to Petalburg City",
      "Defeat Normal type Gym",
      "Talk to Wally's house & Obtain HM03 - Surf",
      "Return to Mauville City",
      "Talk to Wattson to botain Basement Key",
      "Use Surf on Route 118 & Talk to Steven",
      "Enter the Weather Institute",
      "Defeat trainers & talk to the scientist to receive Castform",
      "Battle your rival outside",
      "Reach Fortree City",
      "Attempt to approach the Gym path and investigate the invisible obstacle",
      "Receive from Steven 'Devon Scope'",
      "Use the Devon Scope on the invisible Kecleon",
      "Defeat Flying Type Gym",
      "Continue east toward Lilycove",
      "Surf to Mt. Pyre",
      "Climb to the summit of Mt. Pyre",
      "Return to Lilycove City",
      "Enter the Team Aqua Hideout now that it is open",
      "Fly or travel to Slateport City",
      "Go to the harbor and watch Team Aqua steal the submarine",
      "Reach Mossdeep City",
      "Defeat Psychic Type Gym",
      "Visit Steven’s house after winning the badge",
      "Go to the Space Center after receiving Dive",
      "Defeat Team Aqua",
      "Leave Mossdeep and Surf south",
      "Find a dark underwater diving spot",
      "Use Dive and search underwater",
      "Find the entrance to Seafloor Cavern and surface",
      "Navigate the cave and defeat Team Aqua grunts",
      "Leave and head to Sootopolis City",
      "Go to the Cave of Origin as directed",
      "Complete the story trigger inside",
      "Make sure you have the Mach Bike",
      "Travel to Sky Pillar",
      "Climb Sky Pillar using the Mach Bike where required",
      "Reach the top and awaken Rayquaza",
      "Return to Sootopolis City",
      "Defeat Water type Gym",
      "Use Waterfall to climb the falls at the Pokémon League entrance route",
      "Enter Ever Grande City",
      "Enter Victory Road",
      "Defeat the Elite Four and become the Champion!"
    ],
